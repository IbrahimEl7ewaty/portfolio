      "paragraphs": [
        {
          "id": "about-paragraphs-0",
          "enabled": true,
          "paragraph": "I'm Ibrahim Maher El-Hewaty, an IT Operations Supervisor with experience managing day-to-day technology in hospitality. I work across network infrastructure, system administration, user support and IT security to keep hotel departments connected.",
          "_template": "0"
        },
        {
          "id": "about-paragraphs-1",
          "enabled": true,
          "paragraph": "At Wadi Lahmy Azur Resort, I supported servers, workstations, guest connectivity and security systems. My background also includes freelance IT support and Flutter development, giving me a practical understanding of both infrastructure and software.",
          "_template": "1"
        },
        {
          "id": "about-paragraphs-2",
          "enabled": true,
          "paragraph": "My focus is IT operations: dependable networks, well-maintained systems and clear support for the people who use them.",
          "_template": "2"
        }
